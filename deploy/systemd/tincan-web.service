# tincan-web.service — install to ~/.config/systemd/user/
[Unit]
Description=tincan web chat
After=network-online.target

[Service]
# Add --committees-from macmini to keep committee definitions on the Mac
# (see docs/web.md "Committees"); without it this machine is its own hub.
ExecStart=%h/.local/bin/tincan web --public-path /tincan --peer macmini=https://macmini.brill-decibel.ts.net/tincan/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
